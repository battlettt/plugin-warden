     "esbuild": "^0.25.12",
     "prettier": "3.8.1",
     "tsx": "^4.7.0",
     "typescript": "^5.9.3",
     "vercel": "^37.0.0",
     "vitest": "4.1.5"
    },
    "bin": {
     "exa-mcp-server": "dist/stdio.cjs"
    }
